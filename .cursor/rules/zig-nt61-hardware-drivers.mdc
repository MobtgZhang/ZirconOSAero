## 二、PCI/PCIe 总线驱动

PCI 总线是连接大多数现代设备的通用总线，驱动必须先枚举总线才能发现设备。

```zig
// drivers/bus/pci.zig
// 参考：PCI Local Bus Specification Rev 3.0
//       PCI Express Base Specification Rev 5.0（ECam 访问方式）

/// PCI 设备标识
pub const PciAddress = packed struct(u32) {
    func:    u3,   // 功能号（0~7）
    dev:     u5,   // 设备号（0~31）
    bus:     u8,   // 总线号（0~255）
    _pad:    u16,
};

/// PCI 配置空间访问（ECAM：Enhanced Configuration Access Mechanism）
/// 所有架构通用。物理地址 = MMCFG_BASE + (bus<<20 | dev<<15 | func<<12 | reg)
/// 参考：PCIe Spec §7.2.2
pub const PciEcam = struct {
    base: usize, // MMCFG 基地址（从 ACPI MCFG 表读取）

    pub fn readU8(self: PciEcam, addr: PciAddress, reg: u12) u8 {
        const offset = (@as(usize, addr.bus) << 20) |
                       (@as(usize, addr.dev) << 15) |
                       (@as(usize, addr.func) << 12) | reg;
        const ptr: *volatile u8 = @ptrFromInt(self.base + offset);
        return ptr.*;
    }
    pub fn readU16(self: PciEcam, addr: PciAddress, reg: u12) u16 {
        const offset = (@as(usize, addr.bus) << 20) |
                       (@as(usize, addr.dev) << 15) |
                       (@as(usize, addr.func) << 12) | (reg & ~@as(u12, 1));
        const ptr: *volatile u16 = @ptrFromInt(self.base + offset);
        return ptr.*;
    }
    pub fn readU32(self: PciEcam, addr: PciAddress, reg: u12) u32 {
        const offset = (@as(usize, addr.bus) << 20) |
                       (@as(usize, addr.dev) << 15) |
                       (@as(usize, addr.func) << 12) | (reg & ~@as(u12, 3));
        const ptr: *volatile u32 = @ptrFromInt(self.base + offset);
        return ptr.*;
    }
    pub fn writeU32(self: PciEcam, addr: PciAddress, reg: u12, val: u32) void {
        const offset = (@as(usize, addr.bus) << 20) |
                       (@as(usize, addr.dev) << 15) |
                       (@as(usize, addr.func) << 12) | (reg & ~@as(u12, 3));
        const ptr: *volatile u32 = @ptrFromInt(self.base + offset);
        ptr.* = val;
    }
};

/// PCI 标准配置空间头（Type 0，普通设备）
/// 参考：PCI Spec §6.1 Configuration Space Header
pub const PciConfigHeader = extern struct {
    vendor_id:      u16,  // 0x00：厂商 ID（0xFFFF = 设备不存在）
    device_id:      u16,  // 0x02：设备 ID
    command:        u16,  // 0x04：命令寄存器
    status:         u16,  // 0x06：状态寄存器
    revision_id:    u8,   // 0x08：修订 ID
    prog_if:        u8,   // 0x09：编程接口
    subclass:       u8,   // 0x0A：子类码
    class_code:     u8,   // 0x0B：类码
    cache_line:     u8,   // 0x0C：缓存行大小
    latency_timer:  u8,   // 0x0D：延迟定时器
    header_type:    u8,   // 0x0E：头类型（bit[7]=MF，bit[6:0]=类型）
    bist:           u8,   // 0x0F：内置自测
    bar:            [6]u32, // 0x10~0x27：基地址寄存器 BAR0~BAR5
    cardbus_cis:    u32,  // 0x28
    subsystem_vendor: u16, // 0x2C
    subsystem_id:   u16,  // 0x2E
    expansion_rom:  u32,  // 0x30
    cap_pointer:    u8,   // 0x34：能力链表指针
    _reserved:      [7]u8,
    interrupt_line: u8,   // 0x3C：中断线（传统 INTx）
    interrupt_pin:  u8,   // 0x3D：中断引脚（1=INTA#~4=INTD#）
    min_grant:      u8,
    max_latency:    u8,

    // Command 寄存器位域常量
    pub const CMD_IO_SPACE:   u16 = 1 << 0;  // 使能 I/O 端口访问（x86 旧式）
    pub const CMD_MEM_SPACE:  u16 = 1 << 1;  // 使能 MMIO 访问
    pub const CMD_BUS_MASTER: u16 = 1 << 2;  // 使能总线主控（DMA）
    pub const CMD_INT_DISABLE:u16 = 1 << 10; // 禁用传统中断（使用 MSI/MSI-X 时置位）
};

/// PCI 类码（部分，来自 PCI-SIG 公开规范）
pub const PciClass = struct {
    pub const STORAGE_SATA:  u8 = 0x01; // class=0x01, subclass=0x06
    pub const STORAGE_NVME:  u8 = 0x01; // class=0x01, subclass=0x08
    pub const NETWORK:       u8 = 0x02;
    pub const DISPLAY_VGA:   u8 = 0x03;
    pub const USB_XHCI:      u8 = 0x0C; // class=0x0C, subclass=0x03, progif=0x30
};

/// PCI 设备枚举（遍历所有总线/设备/功能）
pub fn enumPciBus(ecam: PciEcam, callback: anytype) void {
    var bus: u16 = 0;
    while (bus < 256) : (bus += 1) {
        var dev: u8 = 0;
        while (dev < 32) : (dev += 1) {
            const addr = PciAddress{ .bus = @intCast(bus), .dev = dev, .func = 0 };
            const vendor = ecam.readU16(addr, 0x00);
            if (vendor == 0xFFFF) continue; // 设备不存在

            const header_type = ecam.readU8(addr, 0x0E);
            const num_funcs: u8 = if (header_type & 0x80 != 0) 8 else 1;

            var func: u8 = 0;
            while (func < num_funcs) : (func += 1) {
                const faddr = PciAddress{ .bus = @intCast(bus), .dev = dev, .func = func };
                const fvendor = ecam.readU16(faddr, 0x00);
                if (fvendor == 0xFFFF) continue;
                callback(ecam, faddr);
            }
        }
    }
}

/// 解析 BAR（Base Address Register）并返回 MMIO 基地址与大小
/// 参考：PCI Spec §6.2.5.1 Address Maps
pub fn parseBar(ecam: PciEcam, addr: PciAddress, bar_idx: u3) struct { base: u64, size: u64, is_64bit: bool } {
    const reg: u12 = 0x10 + @as(u12, bar_idx) * 4;
    const bar0 = ecam.readU32(addr, reg);

    if (bar0 & 1 != 0) return .{ .base = 0, .size = 0, .is_64bit = false }; // I/O BAR，跳过

    const is_64bit = (bar0 >> 1 & 0x3) == 0x2;
    const base: u64 = if (is_64bit) blk: {
        const hi = ecam.readU32(addr, reg + 4);
        break :blk (@as(u64, hi) << 32) | (bar0 & 0xFFFFFFF0);
    } else bar0 & 0xFFFFFFF0;

    // 用全 1 写入 BAR 再读回得到大小掩码
    ecam.writeU32(addr, reg, 0xFFFFFFFF);
    const size_mask = ecam.readU32(addr, reg) & 0xFFFFFFF0;
    ecam.writeU32(addr, reg, bar0); // 恢复原值
    const size: u64 = if (size_mask == 0) 0 else ~@as(u64, size_mask) + 1;

    return .{ .base = base, .size = size, .is_64bit = is_64bit };
}
```


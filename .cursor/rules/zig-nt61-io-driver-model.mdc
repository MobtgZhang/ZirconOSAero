## IRP（I/O 请求包）

```zig
/// IRP 主功能码（参考 WDK 公开文档 IRP_MJ_* 常量）
pub const IrpMajorFunction = enum(u8) {
    create              = 0x00,
    create_named_pipe   = 0x01,
    close               = 0x02,
    read                = 0x03,
    write               = 0x04,
    query_information   = 0x05,
    set_information     = 0x06,
    query_ea            = 0x07,
    set_ea              = 0x08,
    flush_buffers       = 0x09,
    query_volume_information = 0x0A,
    set_volume_information   = 0x0B,
    directory_control   = 0x0C,
    file_system_control = 0x0D,
    device_control      = 0x0E,
    internal_device_control = 0x0F,
    shutdown            = 0x10,
    lock_control        = 0x11,
    cleanup             = 0x12,
    create_mailslot     = 0x13,
    query_security      = 0x14,
    set_security        = 0x15,
    power               = 0x16,
    system_control      = 0x17,
    device_change       = 0x18,
    query_quota         = 0x19,
    set_quota           = 0x1A,
    pnp                 = 0x1B,
    _,
    pub const maximum_function = 0x1B;
};

/// IRP 栈位置（每层设备各有一个）
pub const IrpStackLocation = extern struct {
    major_function:     u8,
    minor_function:     u8,
    flags:              u8,
    control:            u8,
    /// 根据 MajorFunction 解释的参数联合体
    parameters: extern union {
        create: extern struct {
            security_context:     ?*anyopaque,
            options:              u32,
            file_attributes:      u16,
            share_access:         u16,
            ea_length:            u32,
        },
        read: extern struct {
            length:        u32,
            _pad:          u32,
            byte_offset:   LargeInteger,
        },
        write: extern struct {
            length:        u32,
            _pad:          u32,
            byte_offset:   LargeInteger,
        },
        device_io_control: extern struct {
            output_buffer_length: u32,
            _pad:                 u32,
            input_buffer_length:  u32,
            _pad2:                u32,
            io_control_code:      u32,
            type3_input_buffer:   ?*anyopaque,
        },
        others: extern struct {
            argument1: ?*anyopaque,
            argument2: ?*anyopaque,
            argument3: ?*anyopaque,
            argument4: ?*anyopaque,
        },
    },
    device_object:      ?*DeviceObject,
    file_object:        ?*anyopaque,  // FILE_OBJECT（前向引用）
    completion_routine: ?*const fn (*DeviceObject, *Irp, ?*anyopaque) callconv(.winapi) NtStatus,
    context:            ?*anyopaque,
};

/// IRP（I/O 请求包）主结构
/// 参考: https://learn.microsoft.com/en-us/windows-hardware/drivers/ddi/wdm/ns-wdm-_irp
pub const Irp = extern struct {
    type:                   i16,
    size:                   u16,
    mdl_address:            ?*anyopaque,  // MDL（内存描述列表）
    flags:                  u32,
    associated_irp: extern union {
        master_irp:        ?*Irp,
        irp_count:         i32,
        system_buffer:     ?*anyopaque,
    },
    thread_list_entry:      ListEntry,
    io_status: extern struct {
        status:      NtStatus,
        information: usize,
    },
    requestor_mode:         u8,   // KernelMode = 0, UserMode = 1
    pending_returned:       bool,
    stack_count:            i8,
    current_location:       i8,
    cancel:                 bool,
    cancel_irql:            u8,
    apc_environment:        u8,
    allocation_flags:       u8,
    user_io_status_block:   ?*anyopaque,
    user_event:             ?*anyopaque,
    overlay: extern union {
        async_parameters: extern struct {
            user_apc_routine: ?*anyopaque,
            user_apc_context: ?*anyopaque,
        },
        allocation_size: LargeInteger,
    },
    cancel_routine:         ?*anyopaque,
    user_buffer:            ?*anyopaque,
    tail: extern union {
        overlay: extern struct {
            list_entry:      ListEntry,
            current_stack_location: ?*IrpStackLocation,
        },
    },

    // --- 辅助方法 ---

    /// 获取当前 IRP 栈位置
    pub fn getCurrentStackLocation(self: *Irp) *IrpStackLocation {
        return self.tail.overlay.current_stack_location orelse
            @panic("Irp: current stack location is null");
    }

    /// 将当前栈位置向下移动（传递给下层驱动前调用）
    pub fn skipCurrentIrpStackLocation(self: *Irp) void {
        self.current_location += 1;
        self.tail.overlay.current_stack_location =
            @ptrFromInt(@intFromPtr(self.tail.overlay.current_stack_location) +
                @sizeOf(IrpStackLocation));
    }

    /// 设置 IRP 完成状态
    pub fn complete(self: *Irp, status: NtStatus, information: usize) void {
        self.io_status.status      = status;
        self.io_status.information = information;
    }
};
```


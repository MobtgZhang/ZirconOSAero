## UNICODE_STRING

NT 内核使用 `UNICODE_STRING` 而非 C 风格 null 结尾字符串。

```zig
/// NT Unicode 字符串（UTF-16LE）
/// 参考: https://learn.microsoft.com/en-us/windows/win32/api/ntdef/ns-ntdef-_unicode_string
pub const UnicodeString = extern struct {
    /// 当前字符串字节长度（不含 null 终止符，单位：字节）
    length: u16,
    /// Buffer 的最大容量（字节）
    maximum_length: u16,
    /// 指向 UTF-16LE 编码的字符缓冲区（可以不以 null 结尾）
    buffer: [*]u16,

    /// 从 Zig comptime UTF-8 字面量构造（仅用于内核初始化阶段的静态字符串）
    pub fn initLiteral(comptime utf8: []const u8) UnicodeString {
        // comptime 转换 UTF-8 -> UTF-16LE
        const utf16 = comptime blk: {
            var buf: [utf8.len]u16 = undefined;
            for (utf8, 0..) |c, i| buf[i] = c; // 仅适用于 ASCII 子集
            break :blk buf;
        };
        return .{
            .length         = @intCast(utf16.len * 2),
            .maximum_length = @intCast(utf16.len * 2),
            .buffer         = @constCast(&utf16),
        };
    }

    /// 判断两个 UnicodeString 是否相等（大小写敏感）
    pub fn equals(self: UnicodeString, other: UnicodeString) bool {
        if (self.length != other.length) return false;
        const n = self.length / 2;
        return std.mem.eql(u16, self.buffer[0..n], other.buffer[0..n]);
    }
};

/// ANSI_STRING（ASCII / MBCS 字符串）
pub const AnsiString = extern struct {
    length:         u16,
    maximum_length: u16,
    buffer:         [*]u8,
};
```


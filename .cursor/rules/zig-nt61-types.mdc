## LARGE_INTEGER

```zig
/// NT 64 位有符号整数（常用于时间戳）
/// 参考: https://learn.microsoft.com/en-us/windows/win32/api/winnt/ns-winnt-large_integer-r1
pub const LargeInteger = extern union {
    /// 拆分访问（低 32 位 + 高 32 位）
    parts: extern struct {
        low_part:  u32,
        high_part: i32,
    },
    /// 直接访问 64 位值
    quad_part: i64,
};

pub const ULargeInteger = extern union {
    parts: extern struct {
        low_part:  u32,
        high_part: u32,
    },
    quad_part: u64,
};
```


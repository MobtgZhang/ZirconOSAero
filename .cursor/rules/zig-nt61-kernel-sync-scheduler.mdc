## 互斥体（KMUTEX）

```zig
/// 内核互斥体（仅可在 IRQL <= APC_LEVEL 使用）
/// 参考: https://learn.microsoft.com/en-us/windows-hardware/drivers/kernel/kernel-mutexes
pub const KMutex = extern struct {
    header: DispatcherHeader,
    mutation_count: i32,
    owner_thread:   ?*KThread,

    pub fn init(self: *KMutex) void {
        self.header = .{
            .type          = 0x02, // MutantObject
            .signal_state  = 1,
            .wait_list_head = .{ .flink = &self.header.wait_list_head,
                                 .blink = &self.header.wait_list_head },
        };
        self.mutation_count = 0;
        self.owner_thread   = null;
    }

    /// 获取互斥体（可能阻塞当前线程）
    /// timeout: null = 无限等待, 否则为 100ns 单位的负值相对时间
    pub fn acquire(self: *KMutex, timeout: ?*LargeInteger) NtStatus {
        return keWaitForSingleObject(&self.header, .executive, .kernel_mode, false, timeout);
    }

    /// 释放互斥体
    pub fn release(self: *KMutex) void {
        keReleaseMutex(self, false);
    }
};
```


## HAL 接口规范

HAL 将体系结构相关代码与内核核心隔离。所有平台相关操作**必须**通过 HAL 接口调用，
内核核心代码不得直接使用任何平台特定的汇编或寄存器操作。

```zig
// hal/hal.zig - HAL 公开接口定义（所有架构共同遵守）
const sdk = @import("sdk");

/// HAL 接口（通过函数指针表实现平台无关调用）
pub const HalInterface = struct {

    // ── 中断控制器（各架构对应不同硬件）──────────────────────────
    // x86_64:      xAPIC / x2APIC（APIC 寄存器 MMIO + MSR 0x800）
    // aarch64:     GICv2 / GICv3（GICD/GICC/GICR MMIO 寄存器组）
    // riscv64:     PLIC（Platform-Level Interrupt Controller）
    // loongarch64: EIOINTC（扩展 I/O 中断控制器）/ LIOINTC
    initInterruptController: *const fn () void,
    /// 发送 EOI（End Of Interrupt）信号，通知中断控制器当前中断已处理
    sendEoi:   *const fn (vector: u32) void,
    maskIrq:   *const fn (vector: u32) void,
    unmaskIrq: *const fn (vector: u32) void,

    // ── 系统定时器（各架构对应不同硬件）──────────────────────────
    // x86_64:      HPET（推荐）或 LAPIC Timer
    // aarch64:     ARM Generic Timer（CNTPCT_EL0 / CNTVCT_EL0）
    // riscv64:     CLINT mtime 寄存器（M-mode）或 SBI timer 调用（S-mode）
    // loongarch64: 恒定频率计数器（Stable Counter，CSR.TMID）
    /// 初始化定时器并设置目标中断频率
    initTimer: *const fn (frequency_hz: u64) void,
    /// 获取当前时间戳（100ns 精度，NT 纪元 1601-01-01）
    queryTime: *const fn () sdk.LargeInteger,
    /// 设置下一次定时器中断（相对当前时间的纳秒数）
    setTimerOneshot: *const fn (ns: u64) void,

    // ── 处理器间中断（IPI）────────────────────────────────────────
    // x86_64:      通过 LAPIC ICR（中断命令寄存器）发送
    // aarch64:     通过 GICv3 SGI（软件生成中断）发送
    // riscv64:     通过 CLINT msip 位（M-mode）或 SBI IPI 调用（S-mode）
    // loongarch64: 通过 IPI 控制寄存器（CSR.IPI_SEND）发送
    sendTlbFlushIpi:  *const fn (target_cpu: u32, vaddr: usize) void,
    broadcastIpi:     *const fn (vector: u32) void,
    sendGenericIpi:   *const fn (target_mask: u64, vector: u32) void,

    // ── 处理器信息 ────────────────────────────────────────────────
    getCurrentProcessorNumber: *const fn () u32,
    getProcessorCount:         *const fn () u32,

    // ── I/O 访问（x86_64 有端口 I/O；其他架构均为 MMIO）─────────
    // 注意：非 x86 架构的实现将此组函数置为 unreachable（编译期报错防止误用）
    ioInByte:   ?*const fn (port: u16) u8,
    ioOutByte:  ?*const fn (port: u16, value: u8) void,
    ioInWord:   ?*const fn (port: u16) u16,
    ioOutWord:  ?*const fn (port: u16, value: u16) void,
    ioInDword:  ?*const fn (port: u16) u32,
    ioOutDword: ?*const fn (port: u16, value: u32) void,

    // ── TLB 管理 ──────────────────────────────────────────────────
    // x86_64:      invlpg 指令 / mov cr3
    // aarch64:     TLBI VAE1IS / TLBI VMALLE1IS 系统指令
    // riscv64:     sfence.vma 指令
    // loongarch64: invtlb 指令
    tlbFlushPage: *const fn (vaddr: usize) void,
    tlbFlushAll:  *const fn () void,

    // ── 电源管理（跨架构统一接口）────────────────────────────────
    // x86_64:      ACPI S5 睡眠状态 / HLT 指令
    // aarch64:     PSCI（Power State Coordination Interface）
    // riscv64:     SBI HSM（Hart State Management）扩展
    // loongarch64: ACPI 或平台特定 CSR
    powerOff:  *const fn () noreturn,
    reboot:    *const fn () noreturn,
    /// 使当前 CPU 核心进入低功耗等待状态（等同于 HLT/WFI/WFE）
    cpuRelax:  *const fn () void,
};

/// 当前平台的 HAL 实例（内核初始化阶段由各架构 HAL 填充）
pub var hal: HalInterface = undefined;
```


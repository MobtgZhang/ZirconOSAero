## 各架构 HAL 实现规范

### x86_64 HAL（`hal/x86_64/hal_x86_64.zig`）

```zig
// 参考：Intel 64 and IA-32 Architectures SDM，Vol.3

/// 读取 I/O 端口字节（x86 独有 in/out 指令）
pub fn ioInByte(port: u16) u8 {
    return asm volatile ("inb %[port], %[ret]"
        : [ret]  "={al}" (-> u8)
        : [port] "N{dx}" (port)
        : "memory"
    );
}
pub fn ioOutByte(port: u16, value: u8) void {
    asm volatile ("outb %[value], %[port]"
        :: [port] "N{dx}" (port), [value] "{al}" (value) : "memory");
}

/// 读写 MSR（Model Specific Register）
/// 参考：SDM Vol.3 §10.4 LOCAL APIC 使用 MSR_IA32_APIC_BASE (0x1B)
pub fn readMsr(msr: u32) u64 {
    var lo: u32 = undefined;
    var hi: u32 = undefined;
    asm volatile ("rdmsr"
        : [lo] "={eax}" (lo), [hi] "={edx}" (hi)
        : [cx] "{ecx}" (msr));
    return @as(u64, hi) << 32 | lo;
}
pub fn writeMsr(msr: u32, val: u64) void {
    asm volatile ("wrmsr"
        :: [cx] "{ecx}" (msr),
           [ax] "{eax}" (@as(u32, @truncate(val))),
           [dx] "{edx}" (@as(u32, @intCast(val >> 32))));
}

/// TLB 操作
pub fn tlbFlushPage(vaddr: usize) void {
    asm volatile ("invlpg (%[a])" :: [a] "r" (vaddr) : "memory");
}
pub fn tlbFlushAll() void {
    const cr3 = asm volatile ("mov %%cr3, %[r]" : [r] "=r" (-> u64));
    asm volatile ("mov %[r], %%cr3" :: [r] "r" (cr3) : "memory");
}

/// 等待中断（低功耗）
pub fn cpuRelax() void {
    asm volatile ("hlt" ::: "memory");
}
```


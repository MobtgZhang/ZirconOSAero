## 线程（KTHREAD）骨架

```zig
/// 内核线程控制块（精简版，仅列出关键字段）
pub const KThread = extern struct {
    header:             DispatcherHeader,   // 必须是第一个字段
    cycle_time:         u64,
    quantum_reset:      u32,
    wait_status:        NtStatus,
    wait_irql:          u8,
    wait_mode:          u8,
    wait_next:          bool,
    wait_reason:        u8,
    wait_block_list:    ?*anyopaque,
    wait_list_entry:    ListEntry,
    priority:           i8,
    base_priority:      i8,
    state:              ThreadState,
    teb:                ?*anyopaque,        // 用户态 TEB（线程环境块）
    // ... 更多字段按需添加

    pub const ThreadState = enum(u8) {
        initialized = 0,
        ready       = 1,
        running     = 2,
        standby     = 3,
        terminated  = 4,
        waiting     = 5,
        transition  = 6,
        deferred_ready = 7,
    };
};
```

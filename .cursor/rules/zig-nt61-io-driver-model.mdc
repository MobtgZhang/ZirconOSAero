## 驱动入口规范

每个 ZirconOSAero 驱动的入口函数必须遵循以下模板：

```zig
// SPDX-License-Identifier: MIT OR Apache-2.0
// ZirconOSAero Driver: [驱动名称]
// Clean-room implementation. Reference: [文档链接]

const kernel = @import("kernel");
const io     = kernel.io;
const mm     = kernel.mm;

/// 驱动入口点（等价于 Windows DriverEntry）
/// 必须使用 .winapi 调用约定以确保 ABI 兼容
pub export fn DriverEntry(
    driver_object:  *kernel.DriverObject,
    registry_path:  *kernel.UnicodeString,
) callconv(.winapi) kernel.NtStatus {
    _ = registry_path;

    // 1. 注册 IRP 分发函数
    driver_object.major_function[@intFromEnum(kernel.IrpMajorFunction.create)]
        = &dispatchCreate;
    driver_object.major_function[@intFromEnum(kernel.IrpMajorFunction.close)]
        = &dispatchClose;
    driver_object.major_function[@intFromEnum(kernel.IrpMajorFunction.device_control)]
        = &dispatchIoctl;
    driver_object.driver_unload = &driverUnload;

    // 2. 创建设备对象
    var device_object: *kernel.DeviceObject = undefined;
    const device_name = kernel.UnicodeString.initLiteral("\\Device\\MyDevice");
    const status = io.ioCreateDevice(
        driver_object,
        @sizeOf(MyDeviceExtension),
        &device_name,
        .unknown,
        0,
        false,
        &device_object,
    );
    if (!status.isSuccess()) return status;

    return .success;
}

fn driverUnload(driver_object: *kernel.DriverObject) callconv(.winapi) void {
    // 删除设备对象、符号链接等
    _ = driver_object;
}

fn dispatchCreate(device: *kernel.DeviceObject, irp: *kernel.Irp) callconv(.winapi) kernel.NtStatus {
    irp.complete(.success, 0);
    return io.ioCompleteRequest(irp, 0);
}

fn dispatchClose(device: *kernel.DeviceObject, irp: *kernel.Irp) callconv(.winapi) kernel.NtStatus {
    irp.complete(.success, 0);
    return io.ioCompleteRequest(irp, 0);
}

fn dispatchIoctl(device: *kernel.DeviceObject, irp: *kernel.Irp) callconv(.winapi) kernel.NtStatus {
    const stack = irp.getCurrentStackLocation();
    const ioctl_code = stack.parameters.device_io_control.io_control_code;
    _ = ioctl_code;
    irp.complete(.not_implemented, 0);
    return io.ioCompleteRequest(irp, 0);
}

const MyDeviceExtension = struct {
    // 驱动私有状态
};
```


### RISC-V 64 HAL（`hal/riscv64/hal_riscv64.zig`）

```zig
// 参考：
//   RISC-V Privileged ISA Specification（机器模式/监督者模式 CSR）
//   SBI（Supervisor Binary Interface）Specification v2.0
//   RISC-V PLIC Specification

/// 读写 CSR（Control and Status Register）
/// RISC-V CSR 通过专用指令 csrr/csrw/csrrs/csrc 访问
pub fn csrRead(comptime csr_name: []const u8) u64 {
    return asm volatile ("csrr %[r], " ++ csr_name
        : [r] "=r" (-> u64));
}
pub fn csrWrite(comptime csr_name: []const u8, val: u64) void {
    asm volatile ("csrw " ++ csr_name ++ ", %[v]"
        :: [v] "r" (val) : "memory");
}
pub fn csrSet(comptime csr_name: []const u8, bits: u64) void {
    asm volatile ("csrs " ++ csr_name ++ ", %[v]"
        :: [v] "r" (bits) : "memory");
}
pub fn csrClear(comptime csr_name: []const u8, bits: u64) void {
    asm volatile ("csrc " ++ csr_name ++ ", %[v]"
        :: [v] "r" (bits) : "memory");
}

// 常用 CSR 名称常量
pub const CSR_SSTATUS = "sstatus";  // 监督者状态寄存器
pub const CSR_SIE     = "sie";      // 监督者中断使能
pub const CSR_SIP     = "sip";      // 监督者中断挂起
pub const CSR_STVEC   = "stvec";    // 陷阱向量基地址
pub const CSR_SATP    = "satp";     // S-mode 地址转换（页表根指针）
pub const CSR_SEPC    = "sepc";     // 异常程序计数器
pub const CSR_SCAUSE  = "scause";   // 陷阱原因
pub const CSR_STVAL   = "stval";    // 陷阱值（错误地址等）
pub const CSR_TIME    = "time";     // 只读时间计数器（用户可读）

/// TLB 刷新（RISC-V 使用 sfence.vma 指令）
/// sfence.vma rs1, rs2：rs1=虚拟地址（0=全部），rs2=ASID（0=所有 ASID）
pub fn tlbFlushPage(vaddr: usize) void {
    asm volatile ("sfence.vma %[a], zero" :: [a] "r" (vaddr) : "memory");
}
pub fn tlbFlushAll() void {
    asm volatile ("sfence.vma zero, zero" ::: "memory");
}

/// SBI 调用（通过 ecall 进入 M-mode 固件，如 OpenSBI）
/// 参考：SBI Spec §3 Binary Encoding
fn sbiCall(eid: u64, fid: u64, a0: u64, a1: u64) struct { err: i64, val: u64 } {
    var err: i64 = undefined;
    var val: u64 = undefined;
    asm volatile ("ecall"
        : [e] "={x10}" (err), [v] "={x11}" (val)
        : [a7] "{x17}" (eid),  [a6] "{x16}" (fid),
          [a0] "{x10}" (a0),  [a1] "{x11}" (a1)
        : "memory"
    );
    return .{ .err = err, .val = val };
}
/// SBI Timer 扩展（EID=0x54494D45 "TIME"）：设置下次定时器中断
pub fn sbiSetTimer(stime_value: u64) void {
    _ = sbiCall(0x54494D45, 0, stime_value, 0);
}
/// SBI IPI 扩展（EID=0x735049 "sPI"）：发送 IPI
pub fn sbiSendIpi(hart_mask: u64, hart_mask_base: u64) void {
    _ = sbiCall(0x735049, 0, hart_mask, hart_mask_base);
}
/// SBI System Reset（EID=0x53525354 "SRST"）
pub fn sbiSystemReset(reset_type: u32, reset_reason: u32) noreturn {
    _ = sbiCall(0x53525354, 0, reset_type, reset_reason);
    unreachable;
}

pub fn cpuRelax() void {
    asm volatile ("wfi" ::: "memory");
}
```


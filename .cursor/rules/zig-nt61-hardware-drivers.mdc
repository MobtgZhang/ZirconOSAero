## 三、UART 串口驱动（调试基础设施）

UART 是内核最早需要初始化的驱动，用于调试输出。各架构使用不同的 UART 控制器。

### 16550 兼容 UART（x86_64 / LoongArch64）

```zig
// drivers/uart/ns16550.zig
// 参考：National Semiconductor 16550A UART 数据手册
// x86_64 通过端口 I/O 访问；LoongArch64 通过 MMIO 访问

pub const Ns16550 = struct {
    // 寄存器偏移（相对 base）
    pub const RBR = 0;  // Receive Buffer Register（读）/ Transmit Holding（写），DLAB=0
    pub const IER = 1;  // Interrupt Enable Register，DLAB=0
    pub const IIR = 2;  // Interrupt Identification Register（读）
    pub const FCR = 2;  // FIFO Control Register（写）
    pub const LCR = 3;  // Line Control Register（bit7=DLAB）
    pub const MCR = 4;  // Modem Control Register
    pub const LSR = 5;  // Line Status Register
    pub const MSR = 6;  // Modem Status Register
    pub const DLL = 0;  // Divisor Latch Low，DLAB=1
    pub const DLH = 1;  // Divisor Latch High，DLAB=1

    // LSR 位
    pub const LSR_DR:   u8 = 0x01; // Data Ready（接收缓冲有数据）
    pub const LSR_THRE: u8 = 0x20; // Transmitter Holding Register Empty（可发送）

    base: u32, // I/O 基地址（x86: 0x3F8=COM1）或 MMIO 虚拟地址

    pub fn init(self: Ns16550, baud: u32, clock_hz: u32) void {
        const divisor: u16 = @intCast(clock_hz / (16 * baud));
        self.write(Ns16550.LCR, 0x80);           // DLAB=1
        self.write(Ns16550.DLL, @truncate(divisor));
        self.write(Ns16550.DLH, @intCast(divisor >> 8));
        self.write(Ns16550.LCR, 0x03);           // DLAB=0，8N1（8 位，无奇偶，1 停止位）
        self.write(Ns16550.FCR, 0xC7);           // 启用并清空 FIFO，触发阈值 14 字节
        self.write(Ns16550.IER, 0x00);           // 先禁用所有中断（轮询模式）
    }

    pub fn putChar(self: Ns16550, c: u8) void {
        // 等待发送缓冲空
        while (self.read(Ns16550.LSR) & Ns16550.LSR_THRE == 0) {}
        self.write(Ns16550.RBR, c);
    }

    pub fn getChar(self: Ns16550) ?u8 {
        if (self.read(Ns16550.LSR) & Ns16550.LSR_DR == 0) return null;
        return self.read(Ns16550.RBR);
    }

    // x86_64：端口 I/O；其他架构：MMIO（通过 MmioRegion）
    fn read(self: Ns16550, reg: u8) u8 {
        if (comptime builtin.cpu.arch == .x86_64) {
            return hal.ioInByte.?(@intCast(self.base + reg));
        } else {
            const ptr: *volatile u8 = @ptrFromInt(self.base + reg);
            return ptr.*;
        }
    }
    fn write(self: Ns16550, reg: u8, val: u8) void {
        if (comptime builtin.cpu.arch == .x86_64) {
            hal.ioOutByte.?(@intCast(self.base + reg), val);
        } else {
            const ptr: *volatile u8 = @ptrFromInt(self.base + reg);
            ptr.* = val;
        }
    }
};
```

### ARM PL011 UART（AArch64，如 QEMU virt 机器）

```zig
// drivers/uart/pl011.zig
// 参考：ARM PrimeCell UART PL011 Technical Reference Manual（DDI 0183）

pub const Pl011 = struct {
    // 寄存器偏移（MMIO，32 位宽）
    pub const DR     = 0x000; // 数据寄存器（读=接收，写=发送）
    pub const FR     = 0x018; // 标志寄存器
    pub const IBRD   = 0x024; // 整数波特率除数
    pub const FBRD   = 0x028; // 小数波特率除数
    pub const LCRH   = 0x02C; // 线路控制寄存器
    pub const CR     = 0x030; // 控制寄存器
    pub const IMSC   = 0x038; // 中断掩码设置/清除寄存器
    pub const ICR    = 0x044; // 中断清除寄存器

    // FR 寄存器位
    pub const FR_TXFF: u32 = 1 << 5; // 发送 FIFO 满
    pub const FR_RXFE: u32 = 1 << 4; // 接收 FIFO 空

    mmio: Mmio32,

    pub fn init(self: Pl011, baud: u32, ref_clock_hz: u32) void {
        // 禁用 UART
        self.mmio.write(Pl011.CR, 0);
        // 计算波特率：BRD = ref_clock / (16 * baud)
        const brd = ref_clock_hz / (16 * baud);
        const frac = ((ref_clock_hz % (16 * baud)) * 64 + baud / 2) / baud;
        self.mmio.write(Pl011.IBRD, brd);
        self.mmio.write(Pl011.FBRD, frac);
        // 8N1，使能 FIFO
        self.mmio.write(Pl011.LCRH, (0x3 << 5) | (1 << 4));
        // 使能 TX/RX
        self.mmio.write(Pl011.CR, (1 << 9) | (1 << 8) | 1);
    }

    pub fn putChar(self: Pl011, c: u8) void {
        while (self.mmio.read(Pl011.FR) & Pl011.FR_TXFF != 0) {}
        self.mmio.write(Pl011.DR, c);
    }

    pub fn getChar(self: Pl011) ?u8 {
        if (self.mmio.read(Pl011.FR) & Pl011.FR_RXFE != 0) return null;
        return @truncate(self.mmio.read(Pl011.DR));
    }
};
```

### SiFive UART（RISC-V 64，如 QEMU virt 机器）

```zig
// drivers/uart/sifive.zig
// 参考：SiFive FU740-C000 Manual §18 UART（https://sifive.cdn.prismic.io/）

pub const SiFiveUart = struct {
    pub const TXDATA = 0x00; // [31]=full，[7:0]=发送数据
    pub const RXDATA = 0x04; // [31]=empty，[7:0]=接收数据
    pub const TXCTRL = 0x08; // 发送控制
    pub const RXCTRL = 0x0C; // 接收控制
    pub const IE     = 0x10; // 中断使能
    pub const IP     = 0x14; // 中断挂起
    pub const DIV    = 0x18; // 波特率除数

    mmio: Mmio32,

    pub fn init(self: SiFiveUart, baud: u32, tlclk_hz: u32) void {
        self.mmio.write(SiFiveUart.DIV, tlclk_hz / baud - 1);
        self.mmio.write(SiFiveUart.TXCTRL, 1); // txen=1
        self.mmio.write(SiFiveUart.RXCTRL, 1); // rxen=1
    }

    pub fn putChar(self: SiFiveUart, c: u8) void {
        while (self.mmio.read(SiFiveUart.TXDATA) & 0x80000000 != 0) {} // 等待 full=0
        self.mmio.write(SiFiveUart.TXDATA, c);
    }

    pub fn getChar(self: SiFiveUart) ?u8 {
        const v = self.mmio.read(SiFiveUart.RXDATA);
        if (v & 0x80000000 != 0) return null; // empty=1
        return @truncate(v);
    }
};
```


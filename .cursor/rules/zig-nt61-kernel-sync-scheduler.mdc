## 事件（KEVENT）

```zig
/// 事件类型
pub const EventType = enum(u32) {
    notification_event   = 0,  // 手动重置：signal 后保持信号状态直到 Reset
    synchronization_event = 1, // 自动重置：每次等待成功后自动清除信号
};

/// 内核事件
pub const KEvent = extern struct {
    header: DispatcherHeader,

    pub fn init(self: *KEvent, event_type: EventType, initial_state: bool) void {
        self.header = .{
            .type         = @intFromEnum(event_type),
            .signal_state = @intFromBool(initial_state),
            .wait_list_head = .{
                .flink = &self.header.wait_list_head,
                .blink = &self.header.wait_list_head,
            },
        };
    }

    pub fn set(self: *KEvent, increment: i32, wait: bool) i32 {
        return keSetEvent(self, increment, wait);
    }

    pub fn clear(self: *KEvent) void {
        keClearEvent(self);
    }

    pub fn wait(self: *KEvent, timeout: ?*LargeInteger) NtStatus {
        return keWaitForSingleObject(&self.header, .executive, .kernel_mode, false, timeout);
    }
};
```


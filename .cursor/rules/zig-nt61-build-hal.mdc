# 构建系统与 HAL 规则

## build.zig 多架构架构

整个项目通过单一 `build.zig` 驱动，使用 `-Dtarget=` 选项在编译时切换架构：

```bash
zig build -Dtarget=x86_64-freestanding-none        # x86_64（默认）
zig build -Dtarget=aarch64-freestanding-none        # AArch64
zig build -Dtarget=riscv64-freestanding-none        # RISC-V 64
zig build -Dtarget=loongarch64-freestanding-none    # LoongArch64
```

```zig
// build.zig 多架构骨架
const std = @import("std");

pub fn build(b: *std.Build) void {
    const optimize = b.standardOptimizeOption(.{});

    // ── 目标架构解析 ───────────────────────────────────────────────
    // 默认 x86_64，通过 -Dtarget= 覆盖
    const target_query = b.standardTargetOptions(.{
        .default_target = .{
            .cpu_arch = .x86_64,
            .os_tag   = .freestanding,
            .abi      = .none,
        },
    });
    const target   = b.resolveTargetQuery(target_query);
    const arch     = target.result.cpu.arch;

    // ── 架构相关路径 ───────────────────────────────────────────────
    const arch_name = switch (arch) {
        .x86_64      => "x86_64",
        .aarch64     => "aarch64",
        .riscv64     => "riscv64",
        .loongarch64 => "loongarch64",
        else         => @panic("Unsupported architecture"),
    };
    const linker_script = b.fmt("kernel/arch/{s}/kernel.ld", .{arch_name});
    const hal_root      = b.fmt("hal/{s}/hal_{s}.zig",       .{ arch_name, arch_name });

    // ── 架构相关的 CPU 特性裁剪 ────────────────────────────────────
    var kernel_features = std.Target.Cpu.Feature.Set.empty;
    switch (arch) {
        .x86_64 => {
            kernel_features = std.Target.x86.featureSet(&.{
                .avx, .avx2, .avx512f, .sse, .sse2, .sse3,
                .ssse3, .sse4_1, .sse4_2, .mmx,
            });
        },
        .aarch64 => {
            kernel_features = std.Target.aarch64.featureSet(&.{
                .neon, .sve, .sve2, .crypto, .fp_armv8,
            });
        },
        .riscv64 => {
            kernel_features = std.Target.riscv.featureSet(&.{
                .f, .d, .q, .v,
            });
        },
        .loongarch64 => {
            kernel_features = std.Target.loongarch.featureSet(&.{
                .lsx, .lasx,
            });
        },
        else => {},
    }

    // ── SDK 模块（纯类型定义，无平台依赖）────────────────────────
    const sdk_module = b.addModule("zirconsdk", .{
        .root_source_file = b.path("sdk/nt_types.zig"),
        .target           = target,
        .optimize         = optimize,
    });

    // ── HAL 静态库 ────────────────────────────────────────────────
    const hal = b.addStaticLibrary(.{
        .name        = "hal",
        .root_module = b.createModule(.{
            .root_source_file = b.path(hal_root),
            .target           = target,
            .optimize         = optimize,
            .red_zone         = false,
            .stack_check      = false,
            .cpu_features_sub = kernel_features,
        }),
    });
    hal.root_module.addImport("sdk", sdk_module);

    // ── 内核可执行文件 ────────────────────────────────────────────
    const kernel = b.addExecutable(.{
        .name        = b.fmt("zirconaero-{s}", .{arch_name}),
        .root_module = b.createModule(.{
            .root_source_file = b.path("kernel/main.zig"),
            .target           = target,
            .optimize         = optimize,
            .red_zone         = false,
            .stack_check      = false,
            .code_model       = .kernel,
            .cpu_features_sub = kernel_features,
        }),
    });
    kernel.setLinkerScript(b.path(linker_script));
    kernel.root_module.addImport("sdk", sdk_module);
    kernel.root_module.addImport("hal", hal.root_module);
    kernel.linkLibrary(hal);

    // ── QEMU 运行目标（按架构选择 QEMU 命令）────────────────────
    const qemu_cmd = switch (arch) {
        .x86_64 => &[_][]const u8{
            "qemu-system-x86_64",
            "-m", "512M", "-serial", "stdio",
            "-no-reboot", "-d", "int,cpu_reset",
        },
        .aarch64 => &[_][]const u8{
            "qemu-system-aarch64",
            "-M", "virt", "-cpu", "cortex-a72",
            "-m", "512M", "-serial", "stdio",
            "-kernel", // 注意：aarch64 QEMU 使用 -kernel 直接加载
        },
        .riscv64 => &[_][]const u8{
            "qemu-system-riscv64",
            "-M", "virt", "-m", "512M",
            "-serial", "stdio", "-bios", "default",
            // OpenSBI 作为 M-mode 固件，内核作为 S-mode payload
        },
        .loongarch64 => &[_][]const u8{
            "qemu-system-loongarch64",
            "-M", "virt", "-m", "512M",
            "-serial", "stdio",
        },
        else => @panic("No QEMU target for this arch"),
    };

    const qemu_run = b.addSystemCommand(qemu_cmd);
    qemu_run.addArtifactArg(kernel);

    const run_step = b.step("qemu", b.fmt("Run ZirconOSAero ({s}) in QEMU", .{arch_name}));
    run_step.dependOn(&qemu_run.step);

    b.installArtifact(kernel);
}
```

### build.zig.zon 规范

```zon
.{
    .name    = .zirconaero,
    .version = "0.1.0",
    .minimum_zig_version = "0.14.0",
    .fingerprint = 0x0, // 发布时填写
    .dependencies = .{
        // 尽量减少外部依赖，内核代码应自包含
        // 若需要，仅允许无 OS 依赖的纯 Zig 库
    },
    .paths = .{ "build.zig", "build.zig.zon", "kernel", "hal", "sdk", "drivers" },
}
```


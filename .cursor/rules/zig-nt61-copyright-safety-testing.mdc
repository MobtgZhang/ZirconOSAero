## 🐛 调试规范

### 内核调试输出

```zig
// 内核调试打印（串口输出，不依赖显示驱动）
pub const DbgLevel = enum { trace, info, warn, err, crit };

pub fn dbgPrint(comptime level: DbgLevel, comptime fmt: []const u8, args: anytype) void {
    // 格式化到临时缓冲区，然后逐字节写串口（COM1 = 0x3F8）
    var buf: [512]u8 = undefined;
    const msg = std.fmt.bufPrint(&buf, "[{s}] " ++ fmt ++ "\r\n",
        .{@tagName(level)} ++ args) catch return;
    for (msg) |c| {
        hal.outByte(0x3F8, c);  // 写入 COM1 数据寄存器
    }
}

// 便捷宏
pub const DPRINT  = struct {
    pub fn call(comptime fmt: []const u8, args: anytype) void {
        if (builtin.mode == .Debug) dbgPrint(.trace, fmt, args);
    }
};
```

### QEMU 调试配置

```bash
# 开启 GDB 远程调试（等待 GDB 连接后再继续启动）
qemu-system-x86_64 \
    -kernel zig-out/bin/zirconaero \
    -m 512M \
    -serial stdio \
    -S -s \                          # -S: 暂停等待 GDB，-s: 监听 :1234
    -d int,cpu_reset,mmu             # 打印中断、CPU 复位、MMU 事件
    -no-reboot -no-shutdown          # 崩溃后停留，便于查看寄存器

# 在另一个终端连接 GDB
gdb \
    -ex "target remote :1234" \
    -ex "set architecture i386:x86-64" \
    -ex "symbol-file zig-out/bin/zirconaero" \
    -ex "break _kernel_entry"
```

### KeBugCheck 实现规范

```zig
/// 内核崩溃停止码（参考 WDK 公开的 Bug Check 代码列表）
pub const BugCheckCode = enum(u32) {
    irql_not_less_or_equal        = 0x0000000A,
    kmode_exception_not_handled   = 0x0000001E,
    system_thread_exception_not_handled = 0x0000007E,
    unexpected_kernel_mode_trap   = 0x0000007F,
    page_fault_in_nonpaged_area   = 0x00000050,
    driver_irql_not_less_or_equal = 0x000000D1,
    _,
};

/// 内核崩溃（等价于 KeBugCheckEx）
pub fn keBugCheckEx(
    bug_check_code: BugCheckCode,
    param1: usize,
    param2: usize,
    param3: usize,
    param4: usize,
) noreturn {
    // 禁用所有中断
    asm volatile ("cli" ::: "memory");

    // 打印崩溃信息到串口
    dbgPrint(.crit,
        "*** STOP: 0x{X:0>8} (0x{X:0>16}, 0x{X:0>16}, 0x{X:0>16}, 0x{X:0>16})",
        .{ @intFromEnum(bug_check_code), param1, param2, param3, param4 });

    // 永久停机
    while (true) {
        asm volatile ("hlt" ::: "memory");
    }
}
```


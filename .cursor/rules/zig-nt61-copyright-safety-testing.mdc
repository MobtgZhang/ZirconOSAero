## 🧪 测试规范

### 内核单元测试（Zig 内置测试框架）

Zig 内置 `test` 块，可以在 `freestanding` 目标上运行不依赖 OS 的单元测试。

```zig
// 示例：sdk/nt_types.zig 中的布局验证测试
const std = @import("std");

test "UnicodeString layout" {
    // 验证结构体大小与 ABI 要求一致（x86_64: 16 字节）
    try std.testing.expectEqual(@sizeOf(UnicodeString), 16);
    try std.testing.expectEqual(@offsetOf(UnicodeString, "length"),         0);
    try std.testing.expectEqual(@offsetOf(UnicodeString, "maximum_length"), 2);
    try std.testing.expectEqual(@offsetOf(UnicodeString, "buffer"),         8);
}

test "NtStatus classification" {
    try std.testing.expect(NtStatus.success.isSuccess());
    try std.testing.expect(!NtStatus.access_denied.isSuccess());
    try std.testing.expect(NtStatus.access_denied.isError());
    try std.testing.expect(NtStatus.buffer_overflow.isWarning());
}

test "ListEntry container_of" {
    const TestStruct = struct {
        value: u32 = 42,
        entry: ListEntry = undefined,
    };
    var obj = TestStruct{};
    obj.entry.flink = &obj.entry;
    obj.entry.blink = &obj.entry;

    const recovered = obj.entry.containerOf(TestStruct, "entry");
    try std.testing.expectEqual(recovered.value, 42);
}

test "PageTableEntry bit layout" {
    var pte = PageTableEntry{
        .present = 1, .writable = 1, .user_accessible = 0,
        .write_through = 0, .cache_disabled = 0, .accessed = 0,
        .dirty = 0, .huge_page = 0, .global = 0, ._available = 0,
        .phys_addr = 0x1000, // 物理地址 0x1000000
        .no_execute = 0, ._reserved = 0,
    };
    try std.testing.expectEqual(pte.getPhysAddr(), 0x1000000);
}
```

### 测试运行方式

```bash
# 运行所有单元测试（在主机上运行，不需要 QEMU）
zig test sdk/nt_types.zig
zig test kernel/mm/pool.zig

# 运行所有测试
zig build test
```

### 测试分层策略

| 层次 | 工具 | 运行环境 | 目标 |
|------|------|---------|------|
| 单元测试 | `zig test` | 主机 | 纯 Zig 逻辑（类型布局、算法） |
| 集成测试 | `zig build test-qemu` | QEMU | 内存管理、中断处理、驱动加载 |
| 兼容性测试 | `zig build test-compat` | QEMU + 真实 NT 驱动 | ABI 兼容验证 |


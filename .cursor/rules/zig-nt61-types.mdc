## 基础 NT 类型映射

```zig
// NT 基础类型（参考 WDK ntdef.h / basetsd.h 的公开文档描述）
pub const BOOLEAN   = u8;        // TRUE = 1, FALSE = 0
pub const UCHAR     = u8;
pub const USHORT    = u16;
pub const ULONG     = u32;
pub const ULONG_PTR = usize;
pub const LONGLONG  = i64;
pub const ULONGLONG = u64;
pub const PVOID     = *anyopaque;
pub const HANDLE    = ?*anyopaque; // NULL 是合法的无效句柄值
pub const ACCESS_MASK = u32;

// 指针大小类型（x86_64 下为 64 位）
pub const SIZE_T   = usize;
pub const SSIZE_T  = isize;

// 常量
pub const TRUE: BOOLEAN  = 1;
pub const FALSE: BOOLEAN = 0;
pub const NULL_HANDLE: HANDLE = null;
```


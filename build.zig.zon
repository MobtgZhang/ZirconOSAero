.{
    .name = .zirconos,
    .fingerprint = 0xd481acc174905545,
    .version = "1.0.0",
    .minimum_zig_version = "0.15.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tools",
        "tooling",
        "boot",
        "link",
        "docs",
    },
    .dependencies = .{
        .zigimg = .{
            // 本地路径依赖（保证一致性）：
            // 使用 git submodule 管理时应记录 hash：
            // $ git submodule add https://github.com/MarkAureh/zip.git src/3rd/zigimg
            // $ git rev-parse HEAD (获取当前 hash)
            // 然后在 .gitmodules 中配置
            .path = "src/3rd/zigimg",
            // 推荐使用指定版本：.url = "https://github.com/MarkAureh/zip.git", .hash = "..."
            // 由于使用本地路径，这里依赖路径锁定 + CI 确保一致性
        },
    },
}

### AArch64 HAL（`hal/aarch64/hal_aarch64.zig`）

```zig
// 参考：ARM Architecture Reference Manual (ARM ARM), DDI 0487
//       ARM Generic Interrupt Controller Architecture Specification

/// 读写系统寄存器（AArch64 通过 mrs/msr 系统指令访问）
/// 示例：读取 MPIDR_EL1（多处理器亲和性寄存器，含当前 CPU 编号）
pub fn readMpidr() u64 {
    return asm volatile ("mrs %[r], mpidr_el1"
        : [r] "=r" (-> u64));
}

/// 读取当前异常等级（EL）
pub fn readCurrentEl() u64 {
    return asm volatile ("mrs %[r], CurrentEL"
        : [r] "=r" (-> u64));
}

/// 配置 TCR_EL1（Translation Control Register）
/// 设置虚拟地址位宽（T0SZ/T1SZ）、页粒度（TG0/TG1）
/// 参考：ARM ARM §D13.2.120 TCR_EL1
pub fn writeTcrEl1(val: u64) void {
    asm volatile ("msr tcr_el1, %[v]\n\t isb"
        :: [v] "r" (val) : "memory");
}

/// GICv3 发送 SGI（Software Generated Interrupt）到指定 CPU
/// 参考：GIC Arch Spec §4.8.13 ICC_SGI1R_EL1
pub fn sendSgi(aff3: u8, aff2: u8, aff1: u8, target_list: u16, intid: u4) void {
    const val: u64 =
        (@as(u64, aff3) << 48) |
        (@as(u64, aff2) << 32) |
        (@as(u64, intid) << 24) |
        (@as(u64, aff1) << 16) |
        @as(u64, target_list);
    asm volatile ("msr icc_sgi1r_el1, %[v]\n\t isb"
        :: [v] "r" (val) : "memory");
}

/// TLB 刷新（AArch64 使用 TLBI 系统指令）
/// TLBI VAE1IS：按虚拟地址刷新 EL1（内核）TLB，内部共享域（IS = Inner Shareable）
pub fn tlbFlushPage(vaddr: usize) void {
    asm volatile (
        "tlbi vae1is, %[a]\n\t dsb ish\n\t isb"
        :: [a] "r" (vaddr >> 12) : "memory"
    );
}
/// TLBI VMALLE1IS：刷新所有 EL1 TLB 条目
pub fn tlbFlushAll() void {
    asm volatile (
        "tlbi vmalle1is\n\t dsb ish\n\t isb"
        ::: "memory"
    );
}

/// 等待中断（AArch64 使用 WFI 指令）
pub fn cpuRelax() void {
    asm volatile ("wfi" ::: "memory");
}

/// PSCI 调用（通过 HVC 或 SMC 指令）
/// 参考：Power State Coordination Interface Specification DEN0022
pub fn psciSystemOff() noreturn {
    // PSCI SYSTEM_OFF = 0x84000008（32-bit）
    asm volatile ("hvc #0"
        :: [x0] "{x0}" (@as(u64, 0x84000008)) : "memory");
    unreachable;
}
```


## 句柄表（Handle Table）

```zig
/// 句柄表条目
pub const HandleTableEntry = extern struct {
    /// 指向对象头的指针（低位编码了访问掩码等标志）
    object:         ?*ObjectHeader,
    /// 句柄授予的访问权限
    granted_access: u32,
    attributes:     u32,
};

/// 句柄表（每个进程一个）
pub const HandleTable = struct {
    /// 句柄表条目数组（简化版，生产中应使用多层树结构）
    entries: []HandleTableEntry,
    lock:    SpinLock,
    /// 下一个可用句柄值（NT 句柄是 4 的倍数）
    next_handle: u32,

    pub fn init(allocator: std.mem.Allocator, initial_capacity: usize) !HandleTable {
        return .{
            .entries     = try allocator.alloc(HandleTableEntry, initial_capacity),
            .lock        = SpinLock.init(),
            .next_handle = 4,
        };
    }

    /// 创建句柄，返回句柄值
    pub fn createHandle(
        self: *HandleTable,
        object: *ObjectHeader,
        desired_access: u32,
    ) ?HANDLE {
        const irql = self.lock.acquire();
        defer self.lock.release(irql);

        const index = self.next_handle / 4;
        if (index >= self.entries.len) return null;

        obReferenceObject(object.getBody(anyopaque));
        self.entries[index] = .{
            .object         = object,
            .granted_access = desired_access,
            .attributes     = 0,
        };
        const handle: HANDLE = @ptrFromInt(self.next_handle);
        self.next_handle += 4;
        return handle;
    }

    /// 查找句柄对应的对象
    pub fn lookupObject(self: *HandleTable, handle: HANDLE) ?*ObjectHeader {
        const value = @intFromPtr(handle);
        if (value == 0 or value % 4 != 0) return null;
        const index = value / 4;
        if (index >= self.entries.len) return null;
        return self.entries[index].object;
    }
};
```


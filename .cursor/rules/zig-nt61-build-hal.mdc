## 链接脚本规范（kernel.ld）

```ld
/* kernel/arch/x86_64/kernel.ld
 * ZirconOSAero 内核链接脚本
 * 目标：x86_64 长模式，高地址内核映射
 * 参考：x86_64 处理器手册 + NT 内存布局文档
 */
OUTPUT_FORMAT("elf64-x86-64")
OUTPUT_ARCH(i386:x86-64)
ENTRY(_kernel_entry)

SECTIONS {
    /* 内核虚拟基地址（NT6.1 内核映像通常加载于高地址，
     * 但 ASLR 会偏移；此处用固定地址简化初期开发） */
    . = 0xFFFFFFFF80000000;

    .text : AT(ADDR(.text) - 0xFFFFFFFF80000000) {
        KEEP(*(.multiboot2))   /* 多引导头必须在最前 */
        *(.text._kernel_entry)
        *(.text .text.*)
    }

    .rodata : {
        *(.rodata .rodata.*)
    }

    .data : {
        *(.data .data.*)
    }

    .bss : {
        _bss_start = .;
        *(.bss .bss.*)
        *(COMMON)
        _bss_end = .;
    }

    /* 调试信息（不加载到内存，仅用于 GDB/WinDbg） */
    .debug_info     0 : { *(.debug_info) }
    .debug_abbrev   0 : { *(.debug_abbrev) }
    .debug_line     0 : { *(.debug_line) }
    .debug_str      0 : { *(.debug_str) }
    .debug_ranges   0 : { *(.debug_ranges) }

    _kernel_end = .;
}
```


### LoongArch64 HAL（`hal/loongarch64/hal_loongarch64.zig`）

```zig
// 参考：
//   LoongArch ISA 手册（龙芯官方，https://loongson.github.io/LoongArch-Documentation/）
//   LoongArch ABI 手册
//   龙芯 7A2000 桥片用户手册

/// 读写 CSR（LoongArch CSR 通过 csrrd/csrwr/csrxchg 指令访问）
pub fn csrRead(comptime csr_num: u14) u64 {
    return asm volatile ("csrrd %[r], " ++ std.fmt.comptimePrint("{d}", .{csr_num})
        : [r] "=r" (-> u64));
}
pub fn csrWrite(comptime csr_num: u14, val: u64) void {
    asm volatile ("csrwr %[v], " ++ std.fmt.comptimePrint("{d}", .{csr_num})
        :: [v] "r" (val) : "memory");
}

// 常用 CSR 编号（参考 LoongArch ISA 手册 §7.1）
pub const CSR_CRMD   = 0x0;   // 当前模式信息
pub const CSR_PRMD   = 0x1;   // 异常前模式信息
pub const CSR_EUEN   = 0x2;   // 扩展部件使能
pub const CSR_ECFG   = 0x4;   // 异常配置
pub const CSR_ESTAT  = 0x5;   // 异常状态
pub const CSR_ERA    = 0x6;   // 异常返回地址
pub const CSR_BADV   = 0x7;   // 出错虚地址
pub const CSR_PGDL   = 0x19;  // 低半地址空间页表基地址
pub const CSR_PGDH   = 0x1A;  // 高半地址空间页表基地址
pub const CSR_PGD    = 0x1B;  // 页表基地址（当前地址空间）
pub const CSR_TVAL   = 0x42;  // 定时器计数值（只读）
pub const CSR_TCFG   = 0x41;  // 定时器配置
pub const CSR_TICLR  = 0x44;  // 定时器中断清除

/// TLB 刷新（LoongArch 使用 invtlb 指令）
/// invtlb op, rj, rk：op=操作码，rj=ASID，rk=虚拟地址
pub fn tlbFlushPage(vaddr: usize) void {
    // op=5: 按虚拟地址刷新，匹配当前 ASID
    asm volatile ("invtlb 0x5, $r0, %[a]" :: [a] "r" (vaddr) : "memory");
}
pub fn tlbFlushAll() void {
    // op=0: 刷新所有 TLB 条目
    asm volatile ("invtlb 0x0, $r0, $r0" ::: "memory");
}

/// EIOINTC（扩展 I/O 中断控制器）相关操作
/// 参考：龙芯 7A2000 桥片用户手册 §10 中断控制器
/// EIOINTC 通过 IOCSR（I/O CSR 指令）访问，不是普通 MMIO
pub fn iocsrRead32(addr: u32) u32 {
    return asm volatile ("iocsrrd.w %[r], %[a]"
        : [r] "=r" (-> u32)
        : [a] "r"  (addr));
}
pub fn iocsrWrite32(addr: u32, val: u32) void {
    asm volatile ("iocsrwr.w %[v], %[a]"
        :: [v] "r" (val), [a] "r" (addr) : "memory");
}

pub fn cpuRelax() void {
    // LoongArch 使用 idle 指令（类似 x86 HLT / AArch64 WFI）
    asm volatile ("idle 0" ::: "memory");
}
```


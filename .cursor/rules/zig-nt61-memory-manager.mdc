## 物理内存管理（PFN 数据库）

```zig
/// 物理页帧状态（简化版，参考 NT 内存管理公开文档）
pub const PfnState = enum(u8) {
    active,      // 页面正在使用
    free,        // 空闲（零化或未零化）
    zeroed,      // 已零化的空闲页
    standby,     // 备用（已修改但可被回收）
    modified,    // 已修改（需写回分页文件）
    bad,         // 硬件损坏
};

/// PFN 数据库条目
pub const PfnEntry = extern struct {
    list_entry:     ListEntry,  // 连接空闲/备用/修改链表
    pte_address:    ?*PageTableEntry, // 指向映射此页的 PTE
    state:          PfnState,
    reference_count: u16,
    _pad:           [5]u8,
};
```


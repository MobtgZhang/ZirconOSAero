## 引用计数 API

```zig
/// 增加对象引用计数（防止对象被销毁）
/// 参考: https://learn.microsoft.com/en-us/windows-hardware/drivers/ddi/wdm/nf-wdm-obfreferenceobject
pub fn obReferenceObject(object: *anyopaque) void {
    const header = ObjectHeader.fromBody(anyopaque, object);
    _ = @atomicRmw(i64, &header.pointer_count, .Add, 1, .seq_cst);
}

/// 减少对象引用计数，若归零则触发删除例程
/// 参考: https://learn.microsoft.com/en-us/windows-hardware/drivers/ddi/wdm/nf-wdm-obdereferenceobject
pub fn obDereferenceObject(object: *anyopaque) void {
    const header = ObjectHeader.fromBody(anyopaque, object);
    const prev = @atomicRmw(i64, &header.pointer_count, .Sub, 1, .seq_cst);
    if (prev == 1) {
        // 引用计数到零，触发对象的 DeleteProcedure
        if (header.type_info) |type_info| {
            if (type_info.type_info.delete_procedure) |del| {
                // 调用对象类型的删除回调
                const delete_fn: *const fn (*anyopaque) callconv(.winapi) void = @ptrCast(del);
                delete_fn(object);
            }
        }
        // 释放对象内存
        exFreePoolWithTag(@ptrCast(header), makeTag("ObHd"));
    }
}
```


## 安全子系统（Se）基础

```zig
/// 访问掩码常量（来自 WDK 公开文档）
pub const AccessMask = struct {
    // 通用权限
    pub const GENERIC_READ:    u32 = 0x80000000;
    pub const GENERIC_WRITE:   u32 = 0x40000000;
    pub const GENERIC_EXECUTE: u32 = 0x20000000;
    pub const GENERIC_ALL:     u32 = 0x10000000;
    // 标准权限
    pub const DELETE:                u32 = 0x00010000;
    pub const READ_CONTROL:          u32 = 0x00020000;
    pub const WRITE_DAC:             u32 = 0x00040000;
    pub const WRITE_OWNER:           u32 = 0x00080000;
    pub const SYNCHRONIZE:           u32 = 0x00100000;
    pub const STANDARD_RIGHTS_ALL:   u32 = 0x001F0000;
    pub const STANDARD_RIGHTS_READ:  u32 = READ_CONTROL;
    pub const STANDARD_RIGHTS_WRITE: u32 = READ_CONTROL;
};

/// 访问状态检查结果
pub const AccessState = struct {
    granted_access:     u32,
    remaining_access:   u32,
    privileges_used:    bool,
};

/// 访问检查（简化版）
/// 参考: https://learn.microsoft.com/en-us/windows-hardware/drivers/ddi/wdm/nf-wdm-seaccesscheck
pub fn seAccessCheck(
    security_descriptor: ?*anyopaque,
    subject_context:     ?*anyopaque,
    subject_context_locked: bool,
    desired_access:      u32,
    previously_granted_access: u32,
    generic_mapping:     *const GenericMapping,
    granted_access:      *u32,
    access_status:       *NtStatus,
) bool {
    // Clean-room 实现要点（基于文档行为描述）：
    // 1. 若 security_descriptor 为 null，拒绝访问。
    // 2. 将通用权限（GENERIC_*）通过 generic_mapping 映射为特定权限。
    // 3. 遍历 DACL（自主访问控制列表）中的 ACE。
    // 4. 按顺序匹配 Deny ACE（优先于 Allow ACE）。
    // 5. 若所有 desired_access 位均被允许，返回 true 并设置 granted_access。
    _ = security_descriptor;
    _ = subject_context;
    _ = subject_context_locked;
    _ = generic_mapping;
    _ = previously_granted_access;
    // 初期简化：内核调用者拥有所有权限
    granted_access.* = desired_access;
    access_status.*  = .success;
    return true;
}
```


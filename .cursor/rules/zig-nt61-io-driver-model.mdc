## DEVICE_OBJECT 与 DRIVER_OBJECT

```zig
/// 设备对象
/// 参考: https://learn.microsoft.com/en-us/windows-hardware/drivers/ddi/wdm/ns-wdm-_device_object
pub const DeviceObject = extern struct {
    type:                   i16,
    size:                   u16,
    reference_count:        i32,
    driver_object:          *DriverObject,
    next_device:            ?*DeviceObject,
    attached_device:        ?*DeviceObject,
    current_irp:            ?*Irp,
    timer:                  ?*anyopaque,
    flags:                  u32,
    characteristics:        u32,
    vpb:                    ?*anyopaque,
    device_extension:       ?*anyopaque,  // 驱动私有扩展区
    device_type:            u32,
    stack_size:             i8,
    queue: extern union {
        list_head:     ListEntry,
        assign_queue:  ?*anyopaque,
    },
    alignment_requirement:  u32,
    device_queue:           extern struct { type: i16, size: u16, list_head: ListEntry, busy: u32 },
    dpc:                    [4]usize,     // KDPC
    active_thread_count:    u32,
    security_descriptor:    ?*anyopaque,
    device_lock:            extern struct { event: [4]usize },
    sector_size:            u16,
    spare1:                 u16,
    device_object_extension: ?*anyopaque,
    reserved:               ?*anyopaque,
};

/// 驱动对象
/// 参考: https://learn.microsoft.com/en-us/windows-hardware/drivers/ddi/wdm/ns-wdm-_driver_object
pub const DriverObject = extern struct {
    type:               i16,
    size:               i16,
    device_object:      ?*DeviceObject,
    flags:              u32,
    driver_start:       ?*anyopaque,
    driver_size:        u32,
    driver_section:     ?*anyopaque,
    driver_extension:   ?*anyopaque,
    driver_name:        UnicodeString,
    hardware_database:  ?*UnicodeString,
    fast_io_dispatch:   ?*anyopaque,
    driver_init:        ?DriverInitFn,
    driver_start_io:    ?DriverStartIoFn,
    driver_unload:      ?DriverUnloadFn,
    /// IRP 分发函数表（IRP_MJ_MAXIMUM_FUNCTION + 1 = 0x1C 个槽位）
    major_function: [0x1C]DispatchFn,
};

// 函数指针类型定义
pub const DriverInitFn    = *const fn (*DriverObject, *UnicodeString) callconv(.winapi) NtStatus;
pub const DriverUnloadFn  = *const fn (*DriverObject) callconv(.winapi) void;
pub const DriverStartIoFn = *const fn (*DeviceObject, *Irp) callconv(.winapi) void;
pub const DispatchFn      = *const fn (*DeviceObject, *Irp) callconv(.winapi) NtStatus;
```

